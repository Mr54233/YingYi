<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.1</TargetFrameworks>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <CopyLocalLockFileAssemblies>True</CopyLocalLockFileAssemblies>
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
    <AssemblyName>YingYi</AssemblyName>
    <PluginOutputPath Condition="'$(PluginOutputPath)' == ''">$(MSBuildProjectDirectory)/../artifacts/$(AssemblyName).dll</PluginOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Web\Resources\shortcuts.js" />
    <None Remove="Web\Resources\strmassistant.js" />
    <None Remove="Web\Resources\indicator.js" />
    <None Remove="Web\Resources\item.js" />
    <None Remove="Web\Resources\list.js" />
    <None Remove="Web\Resources\listcontroller.js" />
    <None Remove="Web\Resources\linkeditems.js" />
    <None Remove="Web\Resources\mediainfo.js" />
    <None Remove="Web\Resources\refreshdialog.js" />
    <None Remove="Web\Resources\libraryoptionseditor.js" />
    <None Remove="Web\Resources\filtermenu.html" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Properties\thumb.png" />
    <EmbeddedResource Include="Web\Resources\shortcuts.js" />
    <EmbeddedResource Include="Web\Resources\strmassistant.js" />
    <EmbeddedResource Include="Web\Resources\indicator.js" />
    <EmbeddedResource Include="Web\Resources\item.js" />
    <EmbeddedResource Include="Web\Resources\list.js" />
    <EmbeddedResource Include="Web\Resources\listcontroller.js" />
    <EmbeddedResource Include="Web\Resources\linkeditems.js" />
    <EmbeddedResource Include="Web\Resources\mediainfo.js" />
    <EmbeddedResource Include="Web\Resources\refreshdialog.js" />
    <EmbeddedResource Include="Web\Resources\libraryoptionseditor.js" />
    <EmbeddedResource Include="Web\Resources\filtermenu.html" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CHTCHSConv" Version="1.0.0">
    </PackageReference>
    <PackageReference Include="ILRepack" Version="2.0.42">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="mediabrowser.server.core" Version="4.8.0.80" />
    <!-- TinyPinyin (MIT) powers the pinyin layer (P1-1 / P1-2). It is merged into
         YingYi.dll by the PostBuild ILRepack step below; see THIRD-PARTY-NOTICES.md. -->
    <PackageReference Include="TinyPinyin" Version="1.1.0" />
    <!-- SQLitePCL.pretty is provided by the Emby host at runtime; only its compile time
         surface is needed, so it must never be shipped or repacked. -->
    <PackageReference Include="SQLitePCL.pretty.core" Version="1.2.2">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Resource.Embedder" Version="2.2.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.zh-hant.resx">
      <DependentUpon>Resources.resx</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.zh.resx">
      <DependentUpon>Resources.resx</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <PropertyGroup>
      <_PluginOutFull>$([System.IO.Path]::GetFullPath('$(PluginOutputPath)'))</_PluginOutFull>
      <_PluginOutDir>$([System.IO.Path]::GetDirectoryName('$(_PluginOutFull)'))</_PluginOutDir>
      <_TargetPathFull>$([System.IO.Path]::GetFullPath('$(TargetPath)'))</_TargetPathFull>
      <_TargetDirFull>$([System.IO.Path]::GetFullPath('$(TargetDir)'))</_TargetDirFull>
    </PropertyGroup>
    <MakeDir Directories="$(_PluginOutDir)" />
    <Exec WorkingDirectory="$(_PluginOutDir)"
          Command="&quot;$(ILRepack)&quot; /out:&quot;$(_PluginOutFull)&quot; &quot;$(_TargetPathFull)&quot; &quot;$(_TargetDirFull)ChineseConverter.dll&quot; &quot;$(_TargetDirFull)TinyPinyin.dll&quot; /lib:&quot;$(_TargetDirFull)&quot;" />
  </Target>
  <!--
    契约回归（refcheck）构建后置钩子。
    默认不跑（每次构建都跑三个版本会拖慢；沙盒目录也可能不存在）。
    手动开启：dotnet build StrmAssistant/StrmAssistant.csproj -p:RefCheckAfterBuild=true
    原理：refcheck 审计插件 DLL 对 Emby 程序集的每个方法引用是否在目标版本真实存在，
    能抓到「编译期没事、换 Emby 版本运行期才炸」的引用（如 4.9 改 GetChapters 签名）。
    脚本与基线说明见 tools/scripts/refcheck-all.sh。
  -->
  <Target Name="RefCheckAfterBuild" AfterTargets="PostBuild" Condition="'$(RefCheckAfterBuild)' == 'true'">
    <!-- 必须用相对路径：MSBuild 把含中文的绝对路径按 GBK 传给 msys bash 会乱码。
         相对路径不含中文，bash 自己的 cwd 由 Windows API 设置（UTF-8 正常）。 -->
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="bash ../../../tools/scripts/refcheck-all.sh" ContinueOnError="true" />
  </Target>
</Project>
